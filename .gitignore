node_modules/
dist/
*.db
*.db-shm
*.db-wal
.DS_Store
*.vsix
*.zip
*.tsbuildinfo
server/public/
.claude/
.gstack/
.gridlight/

# Expo (mobile app)
.expo/
mobile/.expo/
mobile/dist/
mobile/android/
# mobile/ios/ is now a committed bare-RN project (Expo ejected) — ignore only its artifacts
mobile/ios/Pods/
mobile/ios/build/
mobile/ios/*.xcworkspace/xcuserdata/
mobile/ios/*.xcodeproj/xcuserdata/
mobile/ios/.xcode.env.local

# fastlane — secrets + build artifacts (never commit the API key or .env)
mobile/fastlane/.env
mobile/fastlane/*.p8
mobile/fastlane/report.xml
mobile/fastlane/Preview.html
mobile/fastlane/test_output/
mobile/build/
mobile/*.ipa

# Editor
.vscode/

# Python bytecode
__pycache__/
*.pyc

# Build artifact copied into the extension by prepackage
extension/logo.png

# Generated by agent/install.py — hardcodes absolute machine paths + localhost URL.
.mcp.json

# Machine runner: per-user config, deps, and logs
agent/runner/node_modules/
agent/runner/runner.config.json
agent/runner/logs/
.neoncore/attachments/
package-lock.json

# Secrets. A bot token in a tracked file is a token you have to rotate — this is not a
# convention, it is the reason server/.env exists at all.
.env
.env.*
!.env.example
