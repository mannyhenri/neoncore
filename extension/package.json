{
  "name": "neoncore-extension",
  "displayName": "NeonCore Orchestrator",
  "description": "VS Code companion extension for the NeonCore orchestrator - enables remote command relay to Claude Code",
  "version": "0.5.1",
  "publisher": "gridlight",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "neoncore.connect",
        "title": "NeonCore: Connect to Orchestrator"
      },
      {
        "command": "neoncore.disconnect",
        "title": "NeonCore: Disconnect from Orchestrator"
      }
    ],
    "configuration": {
      "title": "NeonCore",
      "properties": {
        "neoncore.orchestratorUrl": {
          "type": "string",
          "default": "http://localhost:4040",
          "description": "URL of the NeonCore orchestrator server"
        },
        "neoncore.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "Automatically connect to the orchestrator on startup"
        },
        "neoncore.agentType": {
          "type": "string",
          "enum": ["", "claude", "gridlight", "gemini", "amazonq", "codex", "cursor"],
          "enumDescriptions": [
            "Auto-detect (uses app name — Cursor is detected automatically)",
            "Claude Code (Anthropic)",
            "Gridlight",
            "Gemini CLI (Google)",
            "Amazon Q Developer CLI",
            "Codex CLI (OpenAI)",
            "Cursor (auto-detected, but can be forced here)"
          ],
          "default": "",
          "description": "AI agent type for this VS Code workspace. Leave blank to auto-detect."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.94.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "socket.io-client": "^4.8.0"
  }
}
