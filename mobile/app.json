{
  "expo": {
    "name": "NeonCore",
    "slug": "neoncore-mobile",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "neoncore",
    "backgroundColor": "#0d0f12",
    "icon": "./assets/icon.png",
    "updates": {
      "url": "https://u.expo.dev/58c8efd5-84b8-4476-8f92-fca6bf3bf691",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.gridlight.neoncore",
      "buildNumber": "9",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "NeonCore connects to your orchestrator server on the local network.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ai.gridlight.neoncore",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d0f12"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-asset",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0d0f12"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "58c8efd5-84b8-4476-8f92-fca6bf3bf691"
      }
    },
    "owner": "gridlight"
  }
}
