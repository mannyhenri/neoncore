# Copy this to  fastlane/.env  and fill in your values. fastlane auto-loads fastlane/.env.
# fastlane/.env and the .p8 key are gitignored — never commit them.

# ── App Store Connect API key ──────────────────────────────────────────────────────────────
# Create at: App Store Connect ▸ Users and Access ▸ Integrations ▸ App Store Connect API ▸ (+)
# Give it the "App Manager" role. You get an Issuer ID (once), a Key ID, and a downloadable
# AuthKey_XXXXXXXXXX.p8 file (downloadable ONCE — save it into fastlane/).
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_PATH=./fastlane/AuthKey_XXXXXXXXXX.p8

# ── Apple Developer Team ID (10 chars) ─────────────────────────────────────────────────────
# Find at: developer.apple.com/account ▸ Membership details ▸ Team ID
APPLE_TEAM_ID=XXXXXXXXXX
