# NeonCore — iOS TestFlight release automation.
#
#   fastlane beta        # run from the mobile/ directory
#
# One command: regenerate the native iOS project from app.json (this is a managed Expo app,
# so ios/ is a gitignored build artifact), bump the build number past whatever is already on
# TestFlight, build a signed App Store .ipa, and upload it to TestFlight.
#
# One-time credential setup lives in fastlane/SETUP.md. Nothing here is Expo-cloud: the build
# runs entirely on this Mac (Xcode + CocoaPods), and upload goes straight to App Store Connect.

default_platform(:ios)

WORKSPACE = "ios/NeonCore.xcworkspace"
SCHEME    = "NeonCore"
XCODEPROJ = "ios/NeonCore.xcodeproj"
BUNDLE_ID = "ai.gridlight.neoncore"

platform :ios do
  desc "Build a signed App Store .ipa on this Mac and upload it to TestFlight."
  lane :beta do
    # 1. Authenticate with the App Store Connect API key — no Apple ID / 2FA prompts.
    api_key = app_store_connect_api_key(
      key_id:       ENV.fetch("ASC_KEY_ID"),
      issuer_id:    ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
    )

    # 2. Regenerate ios/ from app.json so the build reflects the current version + config
    #    (managed workflow: ios/ is regenerated, not hand-edited). Reuses existing node_modules.
    Dir.chdir("..") do
      sh("npx", "expo", "prebuild", "--platform", "ios", "--clean", "--no-install")
      Dir.chdir("ios") { sh("pod", "install") }
    end

    # 3. Take the next build number above what's on TestFlight (duplicates are rejected).
    #    initial_build_number covers the case where the app has no builds yet.
    next_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      initial_build_number: 15,
    ) + 1
    increment_build_number(xcodeproj: XCODEPROJ, build_number: next_number)

    # 4. Archive + export a signed App Store build. -allowProvisioningUpdates lets Xcode
    #    create/download the distribution provisioning profile using the API key, so you don't
    #    manage profiles by hand. DEVELOPMENT_TEAM is injected because a fresh prebuild has none.
    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      export_method: "app-store",
      output_directory: "build",
      output_name: "NeonCore.ipa",
      xcargs: "-allowProvisioningUpdates DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')} CODE_SIGN_STYLE=Automatic",
      export_options: {
        signingStyle: "automatic",
        teamID: ENV.fetch("APPLE_TEAM_ID"),
      },
    )

    # 5. Upload to TestFlight (build_app hands the .ipa path to pilot automatically).
    upload_to_testflight(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      skip_waiting_for_build_processing: true,
    )

    UI.success("Uploaded build #{next_number} to TestFlight. It'll appear after Apple finishes processing.")
  end
end
