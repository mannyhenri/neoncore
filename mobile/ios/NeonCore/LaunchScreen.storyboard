<?xml version="1.0" encoding="UTF-8"?>
<!--
  NeonCore launch screen.

  Replaces the React Native template default (white background + a "Powered by React Native"
  label). Uses the app's brand dark (#0d0f12, matching theme.bg and the old Expo splash
  backgroundColor) with the wordmark centred, so launch doesn't flash white before the dark UI
  mounts.
-->
