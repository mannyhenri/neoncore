<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  APNs environment. `development` targets Apple's sandbox gateway; Xcode swaps this to
	  `production` when exporting with an App Store distribution profile (which is what
	  TestFlight builds use). Keep the SERVER in step: server/src/lib/apns-push.ts defaults
	  to the production gateway and takes APNS_SANDBOX=1 for sandbox. A mismatch here is the
	  classic "push works in Xcode but not TestFlight" failure.
	-->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
